{
  "name": "nimphy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @nimphy/web dev",
    "build": "pnpm --filter @nimphy/web build",
    "start": "pnpm --filter @nimphy/web start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "commit:check": "node scripts/check-commit.mjs",
    "arch:check": "node scripts/check-docs.mjs && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.0.8",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "26.0.0",
    "prettier": "3.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.8.3",
    "vitest": "3.0.8"
  }
}
