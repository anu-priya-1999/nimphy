# Nimphy Environment Variables Template
# Copy to .env.local for local development. Never commit sensitive values.

# Database (PostgreSQL 16-class)
DATABASE_URL="postgresql://postgres:dev@localhost:5432/nimphy_dev"

# Authentication & Session (ADR-011 OPEN)
SESSION_SECRET="development-session-secret-must-be-at-least-32-chars-long"
AUTH_TRUST_HOST=true

# PayPal Sandbox Configuration (M-07 / ADR-019 / ADR-020)
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="mock_client_id_for_local_development"
PAYPAL_CLIENT_SECRET="mock_client_secret_for_local_development"
PAYPAL_WEBHOOK_ID="mock_webhook_id_for_local_development"

# AI Provider Configuration (M-05 / ADR-007 / ADR-017)
LLM_PROVIDER="fake"
LLM_API_KEY="mock_key_for_fake_provider"
LLM_MODEL="fake-model"
AI_DAILY_BUDGET_USD=10

# Application Configuration
APP_BASE_URL="http://localhost:3000"
PORT=3000

# Feature Flags & Kill Switches (doc 14 §3, doc 22 §10)
FEATURE_CHECKOUT_ENABLED=false
FEATURE_AI_MEMO_ENABLED=false

# Payment State & Sweeper Parameters (doc 08 §5.7, §6)
PAYPAL_ORDER_TTL_MINUTES=180
PAYPAL_CAPTURE_LEASE_SECONDS=60
PAYPAL_EXPIRY_GRACE_MINUTES=15
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_SCHEDULE="1m,5m,15m,1h,3h,6h,12h"
WEBHOOK_SWEEP_BATCH=10

# Data Lifecycle & Deletion (doc 06 §8, ADR-021)
DELETION_PURGE_BATCH=50
DELETION_LEDGER_SINK="local"
